# Kite Connect credentials
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:3000/callback
# Optional: the day's access token, for hosts like Railway. Locally,
# `node kite-auth.js` saves it to kite-token.json instead.
KITE_ACCESS_TOKEN=

# Instrument config (equity: NSE/BSE, futures/options: NFO)
INSTRUMENT_TYPE=equity
EXCHANGE=NSE
TRADINGSYMBOL=RELIANCE

# Trading config
PORTFOLIO_VALUE_INR=50000
MAX_TRADE_SIZE_INR=5000
MAX_TRADES_PER_DAY=3
PAPER_TRADING=true
TIMEFRAME=5m

# Risk and exits
RISK_PER_TRADE_PCT=1
STOP_LOSS_PCT=0.3
TARGET_PCT=0.6
# STRONG = only trade STRONG-confidence signals; WEAK = trade any signal
MIN_CONFIDENCE=STRONG
# Intraday short selling on SELL signals
ALLOW_SHORT=false
ENTRY_SLIPPAGE_PCT=0.1
EXIT_SLIPPAGE_PCT=0.5

# Where the token, logs, open position and trades.csv are kept.
# On Railway, point this at a mounted volume (e.g. /data).
STATE_DIR=.
